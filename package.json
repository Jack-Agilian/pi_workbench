{
  "name": "pi-workbench-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check:environment": "node scripts/check-environment.mjs",
    "typecheck": "node scripts/check-environment.mjs --versions-only && node scripts/pi-type-patch.mjs --check && tsc --noEmit",
    "test:pi-probe": "node scripts/run-pi-probe.mjs",
    "test:pi-tools": "node scripts/run-pi-probe.mjs --tools",
    "test:pi-shell": "node scripts/run-pi-probe.mjs --shell",
    "test:pi-resources": "node scripts/run-pi-probe.mjs --resources",
    "test:pi-auth": "node scripts/run-pi-probe.mjs --auth",
    "test:product-core": "node scripts/run-pi-probe.mjs --product",
    "test:product-sdk": "node scripts/run-pi-probe.mjs --product-sdk",
    "prepare:pi-packages": "node scripts/prepare-pi-package-fixtures.mjs",
    "test:pi-packages": "node scripts/run-pi-probe.mjs --packages",
    "patch:pi-types": "node scripts/check-environment.mjs --versions-only && node scripts/pi-type-patch.mjs",
    "test:pi-types": "node scripts/check-environment.mjs --versions-only && node --test scripts/pi-type-patch.test.mjs packages/pi-adapter/types.test.mjs",
    "test:product-worker": "node scripts/run-product-worker.mjs",
    "demo:product-worker": "node scripts/run-product-worker.mjs --demo",
    "prepare:desktop": "node scripts/prepare-desktop.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "desktop": "node scripts/launch-desktop.mjs --demo",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:desktop-ui": "node scripts/launch-desktop.mjs --demo --smoke-test",
    "test:desktop-shutdown": "node scripts/test-desktop-shutdown.mjs",
    "test:product-shell": "node scripts/run-product-worker.mjs --shell",
    "test:desktop-shell": "node scripts/launch-desktop.mjs --demo --shell-smoke-test",
    "demo:product-shell": "node scripts/run-product-worker.mjs --shell-demo",
    "test:model-integration-offline": "node scripts/run-product-worker.mjs --model",
    "model:config": "node scripts/model-config.mjs",
    "desktop:model": "node scripts/launch-desktop.mjs --model",
    "test:desktop-model": "node scripts/launch-desktop.mjs --model-offline --model-smoke-test",
    "test:model-network": "node scripts/test-model-network.mjs",
    "test:model-config": "node scripts/test-model-config.mjs",
    "validate:model-live": "node scripts/validate-model-live.mjs",
    "model:policy": "node scripts/model-policy.mjs",
    "validate:model-resume": "node scripts/validate-model-resume.mjs",
    "test:model-resume": "node scripts/check-environment.mjs --versions-only && node --import ./scripts/probe-no-network.mjs --test apps/agent-server/tests/model-policy.test.ts scripts/model-resume-stages.test.mjs scripts/model-resume-cli.test.mjs",
    "test:product-file-agent": "node scripts/run-product-worker.mjs --file-agent",
    "test:desktop-file-agent": "node scripts/launch-desktop.mjs --model-files-offline --model-smoke-test",
    "demo:file-agent": "node scripts/launch-desktop.mjs --model-files-offline",
    "validate:file-agent": "node scripts/validate-file-agent.mjs",
    "test:file-acceptance": "node scripts/test-file-acceptance.mjs",
    "test:product-model-shell": "node scripts/run-product-worker.mjs --model-shell",
    "demo:agent-shell": "node scripts/launch-desktop.mjs --model-shell-offline",
    "test:desktop-agent-shell": "node scripts/launch-desktop.mjs --model-shell-offline --model-smoke-test",
    "validate:agent-shell": "node scripts/validate-agent-shell.mjs",
    "test:backend-history": "node scripts/test-backend-history.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
