{
  "name": "pi-workbench-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "check:environment": "node scripts/check-environment.mjs",
    "typecheck": "node scripts/check-environment.mjs --versions-only && node scripts/pi-type-patch.mjs --check && tsc --noEmit",
    "test:pi-probe": "node scripts/run-pi-probe.mjs",
    "test:pi-tools": "node scripts/run-pi-probe.mjs --tools",
    "test:pi-shell": "node scripts/run-pi-probe.mjs --shell",
    "test:pi-resources": "node scripts/run-pi-probe.mjs --resources",
    "test:pi-auth": "node scripts/run-pi-probe.mjs --auth",
    "test:product-core": "node scripts/run-pi-probe.mjs --product",
    "test:product-sdk": "node scripts/run-pi-probe.mjs --product-sdk",
    "prepare:pi-packages": "node scripts/prepare-pi-package-fixtures.mjs",
    "test:pi-packages": "node scripts/run-pi-probe.mjs --packages",
    "patch:pi-types": "node scripts/check-environment.mjs --versions-only && node scripts/pi-type-patch.mjs",
    "test:pi-types": "node scripts/check-environment.mjs --versions-only && node --test scripts/pi-type-patch.test.mjs packages/pi-adapter/types.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
